{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mojoattention/validation-evidence.schema.json",
  "title": "MojoAttention Validation Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "suite_id",
    "source_revision",
    "source_tree",
    "trusted_base_revision",
    "trusted_base_tree",
    "candidate_revision",
    "candidate_tree",
    "trusted_policy_oid",
    "trusted_policy_digest",
    "trusted_schema_oid",
    "trusted_schema_digest",
    "change_set_digest",
    "authorization_id",
    "provenance_digest",
    "contract_digest",
    "config_digest",
    "protocol_digest",
    "declared_case_ids",
    "declared_validation_ids",
    "seed",
    "producer",
    "environment",
    "lifecycle",
    "verdict",
    "validations",
    "attachments",
    "attachment_closure_digest",
    "evidence_digest"
  ],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.0.0"}}},
      "then": {"required": ["suite_manifest_digest"]},
      "else": {"not": {"required": ["suite_manifest_digest"]}}
    }
  ],
  "properties": {
    "schema_version": {"enum": ["1.0.0", "2.0.0"]},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "suite_id": {"$ref": "#/$defs/id"},
    "source_revision": {"$ref": "#/$defs/revision"},
    "source_tree": {"$ref": "#/$defs/revision"},
    "trusted_base_revision": {"$ref": "#/$defs/revision"},
    "trusted_base_tree": {"$ref": "#/$defs/revision"},
    "candidate_revision": {"$ref": "#/$defs/revision"},
    "candidate_tree": {"$ref": "#/$defs/revision"},
    "trusted_policy_oid": {"$ref": "#/$defs/revision"},
    "trusted_policy_digest": {"$ref": "#/$defs/digest"},
    "trusted_schema_oid": {"$ref": "#/$defs/revision"},
    "trusted_schema_digest": {"$ref": "#/$defs/digest"},
    "change_set_digest": {"$ref": "#/$defs/digest"},
    "authorization_id": {
      "anyOf": [
        {"$ref": "#/$defs/id"},
        {"type": "null"}
      ]
    },
    "provenance_digest": {
      "anyOf": [
        {"$ref": "#/$defs/digest"},
        {"type": "null"}
      ]
    },
    "contract_digest": {"$ref": "#/$defs/digest"},
    "suite_manifest_digest": {"$ref": "#/$defs/digest"},
    "config_digest": {"$ref": "#/$defs/digest"},
    "protocol_digest": {"$ref": "#/$defs/digest"},
    "declared_case_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "declared_validation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/validation_id"}
    },
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "producer": {"$ref": "#/$defs/producer"},
    "environment": {"$ref": "#/$defs/environment"},
    "lifecycle": {"const": "complete"},
    "verdict": {
      "enum": ["pass", "product-fail", "infrastructure-invalid", "contract-invalid"]
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/validation"}
    },
    "attachments": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/attachment"},
      "contains": {
        "type": "object",
        "required": ["path"],
        "properties": {"path": {"const": "report.md"}}
      },
      "minContains": 1,
      "maxContains": 1
    },
    "attachment_closure_digest": {"$ref": "#/$defs/digest"},
    "evidence_digest": {"$ref": "#/$defs/digest"}
  },
  "allOf": [
    {
      "if": {
        "required": ["verdict"],
        "properties": {"verdict": {"const": "pass"}}
      },
      "then": {
        "properties": {
          "validations": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/validation"},
                {
                  "properties": {
                    "status": {"const": "pass"},
                    "errors": {"maxItems": 0}
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["verdict"],
        "properties": {"verdict": {"const": "product-fail"}}
      },
      "then": {
        "properties": {
          "validations": {
            "contains": {
              "type": "object",
              "required": ["status"],
              "properties": {"status": {"const": "fail"}}
            },
            "minContains": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9]+(?:[-.][A-Za-z0-9]+)*$"
    },
    "validation_id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*-[0-9]{3}$"
    },
    "safe_text": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "archive_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*//)[^\\u0000-\\u001f\\u007f]+$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\u0000-\\u001f\\u007f]+$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "architecture", "python_version"],
      "properties": {
        "os": {"$ref": "#/$defs/id"},
        "architecture": {"$ref": "#/$defs/id"},
        "python_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": ["value_type"],
            "properties": {"value_type": {"const": "integer"}}
          },
          "then": {"properties": {"value": {"type": "integer"}}}
        }
      ],
      "required": ["name", "value", "value_type", "unit"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "value": {"type": "number"},
        "value_type": {"enum": ["integer", "real"]},
        "unit": {"$ref": "#/$defs/id"}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "context"],
      "properties": {
        "code": {"$ref": "#/$defs/validation_id"},
        "message": {"$ref": "#/$defs/safe_text"},
        "context": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "oneOf": [
              {"type": "string", "maxLength": 1024, "pattern": "^[^\\u0000-\\u001f\\u007f]*$"},
              {"type": "integer"},
              {"type": "number"},
              {"type": "boolean"},
              {"type": "null"}
            ]
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "fail"}}},
          "then": {"properties": {"errors": {"minItems": 1}}}
        },
        {
          "if": {"required": ["status"], "properties": {"status": {"const": "pass"}}},
          "then": {"properties": {"errors": {"maxItems": 0}}}
        }
      ],
      "required": [
        "validation_id",
        "case_id",
        "status",
        "reproduction_argv",
        "metrics",
        "errors",
        "attachments"
      ],
      "properties": {
        "validation_id": {"$ref": "#/$defs/validation_id"},
        "case_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["pass", "fail"]},
        "reproduction_argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        },
        "metrics": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/metric"}
        },
        "errors": {
          "type": "array",
          "maxItems": 1024,
          "items": {"$ref": "#/$defs/error"}
        },
        "attachments": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/archive_path"}
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "size_bytes", "media_type"],
      "properties": {
        "path": {"$ref": "#/$defs/archive_path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size_bytes": {"type": "integer", "minimum": 0},
        "media_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        }
      }
    }
  }
}

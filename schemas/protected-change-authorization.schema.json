{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/mojoattention/protected-change-authorization.schema.json",
  "title": "MojoAttention Protected Change Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "contract_digest",
    "source_revision",
    "trusted_base_revision",
    "trusted_base_tree",
    "candidate_revision",
    "candidate_tree",
    "trusted_policy_oid",
    "trusted_policy_digest",
    "change_set_digest",
    "authorized_protected_paths",
    "approval_anchor_revision",
    "approver_kind",
    "provenance_digest"
  ],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "authorization_id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trusted_base_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trusted_base_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "candidate_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trusted_policy_oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "trusted_policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "change_set_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorized_protected_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "approval_anchor_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "approver_kind": {"const": "human"},
    "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}

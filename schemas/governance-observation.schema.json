{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.invalid/mojoattention/governance-observation.schema.json",
  "type":"object","additionalProperties":false,"required":["schema_version","state_kind","repository","default_branch","head_sha","base_sha","observed_at","api_version","status","controls","provenance"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"state_kind":{"const":"observed-hosted-state"},"repository":{"type":"string","pattern":"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},"default_branch":{"type":"string","minLength":1},"head_sha":{"$ref":"#/$defs/sha"},"base_sha":{"$ref":"#/$defs/sha"},"observed_at":{"type":"string","format":"date-time"},"api_version":{"const":"2026-03-10"},"status":{"enum":["available","unavailable","unauthorized","rate-limited","network-failure","incomplete"]},
    "controls":{"type":"object","additionalProperties":false,"required":["rulesets","classic_branch_protection","actions_full_sha_required","dependency_automation_active"],"properties":{"rulesets":{"type":"array","uniqueItems":true,"items":{"type":"object"}},"classic_branch_protection":{"type":["object","null"]},"actions_full_sha_required":{"type":"boolean"},"dependency_automation_active":{"type":"boolean"}}},
    "provenance":{"type":"object","additionalProperties":false,"required":["source","authenticated","actor","permissions","payload_sha256"],"properties":{"source":{"enum":["github-rest-api","authenticated-export"]},"authenticated":{"const":true},"actor":{"type":"string","minLength":1},"permissions":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},"payload_sha256":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}
  },
  "$defs":{"sha":{"type":"string","pattern":"^[0-9a-f]{40}$"}}
}
